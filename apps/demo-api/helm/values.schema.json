{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "resources"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 2},
    "image": {"type": "object", "required": ["repository", "tag"]},
    "autoscaling": {"type": "object", "properties": {"enabled": {"type": "boolean"}}}
  }
}
